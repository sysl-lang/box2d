// Box2D's entry points, one sysl `extern` per `B2_API` function.
//
// **Each of these was read out of the header rather than remembered.** A signature that disagrees
// links perfectly and corrupts the call, and unlike the *types* beside it — which `layout.sysl`
// checks against the C compiler — there is nothing that can check a signature. So the only defence
// is that they were transcribed once, in order, from `box2d/box2d.h` and `box2d/collision.h`, and
// that the module above exercises them.
//
// **There is no shim, and that is worth stating.** Every one of Box2D's 466 entry points takes
// scalars, pointers and structs by value, all of which sysl can spell since 0.0.55 — so this package
// carries no C of its own at all. The `.c` files in this directory are Box2D's, unedited.
//
// The names drop `b2` and the group prefix's underscore and become snake_case: `b2World_Step` is
// `world_step`, `b2Body_GetPosition` is `body_get_position`. That keeps the C name recoverable by
// eye, which is what matters in a layer whose job is faithfulness.

module sh.sysl.box2d.c

// ## Base

extern "b2GetVersion" version() -> Version
extern "b2GetByteCount" byte_count() -> i32
extern "b2SetLengthUnitsPerMeter" set_length_units_per_meter(length_units: f32)
extern "b2GetLengthUnitsPerMeter" length_units_per_meter() -> f32

// ## Math
//
// Only the handful Box2D does not inline. The other seventy-nine math functions are `static inline`
// and have no symbol to link, so the module above reimplements them in sysl — see its own header for
// why that is the right answer and not a workaround.
//
// **`compute_cos_sin` is bound rather than reimplemented, deliberately.** Box2D uses a polynomial of
// its own instead of the platform's `cosf`/`sinf` so that a simulation replays identically on two
// machines, and calling `sysl.math.cos` here would throw that away.

extern "b2Atan2" atan2(y: f32, x: f32) -> f32
extern "b2ComputeCosSin" compute_cos_sin(radians: f32) -> CosSin
extern "b2ComputeRotationBetweenUnitVectors" rotation_between_unit_vectors(v1: Vec2, v2: Vec2) -> Rot
extern "b2IsValidFloat" is_valid_float(a: f32) -> bool
extern "b2IsValidVec2" is_valid_vec2(v: Vec2) -> bool
extern "b2IsValidRotation" is_valid_rotation(q: Rot) -> bool
extern "b2IsValidAABB" is_valid_aabb(aabb: AABB) -> bool
extern "b2IsValidPlane" is_valid_plane(a: Plane) -> bool

// ## Geometry
//
// A polygon is built rather than filled in: `make_box` and friends bypass the hull, and anything
// else goes through `compute_hull`, which welds close points and drops collinear ones.

extern "b2ComputeHull" compute_hull(points: *Vec2, count: i32) -> Hull
extern "b2ValidateHull" validate_hull(hull: *Hull) -> bool
extern "b2MakePolygon" make_polygon(hull: *Hull, radius: f32) -> Polygon
extern "b2MakeOffsetPolygon" make_offset_polygon(hull: *Hull, position: Vec2, rotation: Rot) -> Polygon
extern "b2MakeOffsetRoundedPolygon" make_offset_rounded_polygon(hull: *Hull, position: Vec2, rotation: Rot,
                                                               radius: f32) -> Polygon
extern "b2MakeSquare" make_square(half_width: f32) -> Polygon
extern "b2MakeBox" make_box(half_width: f32, half_height: f32) -> Polygon
extern "b2MakeRoundedBox" make_rounded_box(half_width: f32, half_height: f32, radius: f32) -> Polygon
extern "b2MakeOffsetBox" make_offset_box(half_width: f32, half_height: f32, center: Vec2, rotation: Rot) -> Polygon
extern "b2MakeOffsetRoundedBox" make_offset_rounded_box(half_width: f32, half_height: f32, center: Vec2,
                                                       rotation: Rot, radius: f32) -> Polygon
extern "b2TransformPolygon" transform_polygon(transform: Transform, polygon: *Polygon) -> Polygon

extern "b2ComputeCircleMass" compute_circle_mass(shape: *Circle, density: f32) -> MassData
extern "b2ComputeCapsuleMass" compute_capsule_mass(shape: *Capsule, density: f32) -> MassData
extern "b2ComputePolygonMass" compute_polygon_mass(shape: *Polygon, density: f32) -> MassData

extern "b2ComputeCircleAABB" compute_circle_aabb(shape: *Circle, transform: Transform) -> AABB
extern "b2ComputeCapsuleAABB" compute_capsule_aabb(shape: *Capsule, transform: Transform) -> AABB
extern "b2ComputePolygonAABB" compute_polygon_aabb(shape: *Polygon, transform: Transform) -> AABB
extern "b2ComputeSegmentAABB" compute_segment_aabb(shape: *Segment, transform: Transform) -> AABB

extern "b2PointInCircle" point_in_circle(point: Vec2, shape: *Circle) -> bool
extern "b2PointInCapsule" point_in_capsule(point: Vec2, shape: *Capsule) -> bool
extern "b2PointInPolygon" point_in_polygon(point: Vec2, shape: *Polygon) -> bool

extern "b2RayCastCircle" ray_cast_circle(input: *RayCastInput, shape: *Circle) -> CastOutput
extern "b2RayCastCapsule" ray_cast_capsule(input: *RayCastInput, shape: *Capsule) -> CastOutput
extern "b2RayCastSegment" ray_cast_segment(input: *RayCastInput, shape: *Segment, one_sided: bool) -> CastOutput
extern "b2RayCastPolygon" ray_cast_polygon(input: *RayCastInput, shape: *Polygon) -> CastOutput

// ## The definitions
//
// Every one of these must be obtained here rather than zero-filled: each carries an `internal_value`
// Box2D checks when the definition comes back, and several carry defaults that are not zero —
// a shape's density is 1, its mask bits are all ones, a body starts awake and enabled.

extern "b2DefaultWorldDef" default_world_def() -> WorldDef
extern "b2DefaultBodyDef" default_body_def() -> BodyDef
extern "b2DefaultShapeDef" default_shape_def() -> ShapeDef
extern "b2DefaultChainDef" default_chain_def() -> ChainDef
extern "b2DefaultFilter" default_filter() -> Filter
extern "b2DefaultQueryFilter" default_query_filter() -> QueryFilter
extern "b2DefaultSurfaceMaterial" default_surface_material() -> SurfaceMaterial
extern "b2DefaultExplosionDef" default_explosion_def() -> ExplosionDef

extern "b2DefaultDistanceJointDef" default_distance_joint_def() -> DistanceJointDef
extern "b2DefaultMotorJointDef" default_motor_joint_def() -> MotorJointDef
extern "b2DefaultMouseJointDef" default_mouse_joint_def() -> MouseJointDef
extern "b2DefaultFilterJointDef" default_filter_joint_def() -> FilterJointDef
extern "b2DefaultPrismaticJointDef" default_prismatic_joint_def() -> PrismaticJointDef
extern "b2DefaultRevoluteJointDef" default_revolute_joint_def() -> RevoluteJointDef
extern "b2DefaultWeldJointDef" default_weld_joint_def() -> WeldJointDef
extern "b2DefaultWheelJointDef" default_wheel_joint_def() -> WheelJointDef

