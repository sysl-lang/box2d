// The five callback registrations. Each takes an address, and since 0.0.55 an `@export`ed sysl
// function has one — see `0136` and `0137`, and the module above for what a caller writes.
extern "b2World_SetCustomFilterCallback" world_set_custom_filter_callback(world_id: WorldId,
                                                                         fcn: *extern(ShapeId, ShapeId, *u8) -> bool,
                                                                         context: *u8)
