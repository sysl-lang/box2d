    OFF_REVOLUTEJOINTDEF_BODY_ID_A: usize = "offsetof(b2RevoluteJointDef, bodyIdA)"
    OFF_REVOLUTEJOINTDEF_BODY_ID_B: usize = "offsetof(b2RevoluteJointDef, bodyIdB)"
    OFF_REVOLUTEJOINTDEF_LOCAL_ANCHOR_A: usize = "offsetof(b2RevoluteJointDef, localAnchorA)"
    OFF_REVOLUTEJOINTDEF_LOCAL_ANCHOR_B: usize = "offsetof(b2RevoluteJointDef, localAnchorB)"
    OFF_REVOLUTEJOINTDEF_REFERENCE_ANGLE: usize = "offsetof(b2RevoluteJointDef, referenceAngle)"
    OFF_REVOLUTEJOINTDEF_TARGET_ANGLE: usize = "offsetof(b2RevoluteJointDef, targetAngle)"
    OFF_REVOLUTEJOINTDEF_ENABLE_SPRING: usize = "offsetof(b2RevoluteJointDef, enableSpring)"
    OFF_REVOLUTEJOINTDEF_HERTZ: usize = "offsetof(b2RevoluteJointDef, hertz)"
    OFF_REVOLUTEJOINTDEF_DAMPING_RATIO: usize = "offsetof(b2RevoluteJointDef, dampingRatio)"
    OFF_REVOLUTEJOINTDEF_ENABLE_LIMIT: usize = "offsetof(b2RevoluteJointDef, enableLimit)"
    OFF_REVOLUTEJOINTDEF_LOWER_ANGLE: usize = "offsetof(b2RevoluteJointDef, lowerAngle)"
    OFF_REVOLUTEJOINTDEF_UPPER_ANGLE: usize = "offsetof(b2RevoluteJointDef, upperAngle)"
    OFF_REVOLUTEJOINTDEF_ENABLE_MOTOR: usize = "offsetof(b2RevoluteJointDef, enableMotor)"
    OFF_REVOLUTEJOINTDEF_MAX_MOTOR_TORQUE: usize = "offsetof(b2RevoluteJointDef, maxMotorTorque)"
    OFF_REVOLUTEJOINTDEF_MOTOR_SPEED: usize = "offsetof(b2RevoluteJointDef, motorSpeed)"
    OFF_REVOLUTEJOINTDEF_DRAW_SIZE: usize = "offsetof(b2RevoluteJointDef, drawSize)"
    OFF_REVOLUTEJOINTDEF_COLLIDE_CONNECTED: usize = "offsetof(b2RevoluteJointDef, collideConnected)"
    OFF_REVOLUTEJOINTDEF_USER_DATA: usize = "offsetof(b2RevoluteJointDef, userData)"
    OFF_REVOLUTEJOINTDEF_INTERNAL_VALUE: usize = "offsetof(b2RevoluteJointDef, internalValue)"

@assert(sizeof(RevoluteJointDef) == SIZEOF_REVOLUTEJOINTDEF, "b2RevoluteJointDef is not the size box2d says it is")
@assert(offsetof(RevoluteJointDef, body_id_a) == OFF_REVOLUTEJOINTDEF_BODY_ID_A, "b2RevoluteJointDef.bodyIdA is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, body_id_b) == OFF_REVOLUTEJOINTDEF_BODY_ID_B, "b2RevoluteJointDef.bodyIdB is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, local_anchor_a) == OFF_REVOLUTEJOINTDEF_LOCAL_ANCHOR_A, "b2RevoluteJointDef.localAnchorA is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, local_anchor_b) == OFF_REVOLUTEJOINTDEF_LOCAL_ANCHOR_B, "b2RevoluteJointDef.localAnchorB is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, reference_angle) == OFF_REVOLUTEJOINTDEF_REFERENCE_ANGLE, "b2RevoluteJointDef.referenceAngle is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, target_angle) == OFF_REVOLUTEJOINTDEF_TARGET_ANGLE, "b2RevoluteJointDef.targetAngle is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, enable_spring) == OFF_REVOLUTEJOINTDEF_ENABLE_SPRING, "b2RevoluteJointDef.enableSpring is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, hertz) == OFF_REVOLUTEJOINTDEF_HERTZ, "b2RevoluteJointDef.hertz is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, damping_ratio) == OFF_REVOLUTEJOINTDEF_DAMPING_RATIO, "b2RevoluteJointDef.dampingRatio is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, enable_limit) == OFF_REVOLUTEJOINTDEF_ENABLE_LIMIT, "b2RevoluteJointDef.enableLimit is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, lower_angle) == OFF_REVOLUTEJOINTDEF_LOWER_ANGLE, "b2RevoluteJointDef.lowerAngle is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, upper_angle) == OFF_REVOLUTEJOINTDEF_UPPER_ANGLE, "b2RevoluteJointDef.upperAngle is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, enable_motor) == OFF_REVOLUTEJOINTDEF_ENABLE_MOTOR, "b2RevoluteJointDef.enableMotor is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, max_motor_torque) == OFF_REVOLUTEJOINTDEF_MAX_MOTOR_TORQUE, "b2RevoluteJointDef.maxMotorTorque is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, motor_speed) == OFF_REVOLUTEJOINTDEF_MOTOR_SPEED, "b2RevoluteJointDef.motorSpeed is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, draw_size) == OFF_REVOLUTEJOINTDEF_DRAW_SIZE, "b2RevoluteJointDef.drawSize is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, collide_connected) == OFF_REVOLUTEJOINTDEF_COLLIDE_CONNECTED, "b2RevoluteJointDef.collideConnected is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, user_data) == OFF_REVOLUTEJOINTDEF_USER_DATA, "b2RevoluteJointDef.userData is not where box2d puts it")
@assert(offsetof(RevoluteJointDef, internal_value) == OFF_REVOLUTEJOINTDEF_INTERNAL_VALUE, "b2RevoluteJointDef.internalValue is not where box2d puts it")

